# Only needed in production (e.g. Vercel). Leave unset for local dev —
# the Vite dev server proxies /api and /ws to http://localhost:8000 instead.
#
# Set to the deployed backend's bare origin, with no trailing slash and no
# /api suffix (the backend's routes are mounted at root, e.g. /rooms, not
# /api/rooms). The app derives the WebSocket URL from this same value.
VITE_API_URL=https://movie-room-api.onrender.com
